# Copy to .env and fill in. Every service below has a free tier — no credit card needed.

# ── ArmorIQ (required) ── https://platform.armoriq.ai
ARMORIQ_API_KEY=ak_live_xxx
USER_ID=your-user-id          # your platform user id / email
AGENT_ID=sentinel-agent       # the agent id you onboarded on the platform
# sdk   = every tool call is decided by ArmorIQ's backend (recommended, shows in dashboard)
# local = decided in-process from the signed intent token's policy snapshot
ARMORIQ_MODE=sdk

# MCP names as onboarded on the ArmorIQ platform (tool names become <mcp>__<tool>)
INBOX_MCP_NAME=inbox
PAYMENTS_MCP_NAME=payments

# ── LLM (required) — any OpenAI-compatible endpoint ──
# Groq (free):   https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_xxx
LLM_MODEL=openai/gpt-oss-120b
# Gemini (free): LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.5-flash
# Ollama (local, free): LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=qwen2.5:7b

# ── ElevenLabs (optional, free tier) ── https://elevenlabs.io/app/settings/api-keys
# Without a key the UI falls back to the browser's built-in speech voice. Use a default voice (e.g. Sarah,
# EXAVITQu4vr4xnSDxMaL): free plans cannot use library voices through the API.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# ── Ports ──
PORT=3000
INBOX_MCP_PORT=4101
PAYMENTS_MCP_PORT=4102
