{
  "name": "sentinel",
  "version": "0.1.0",
  "description": "A voice finance & inbox agent whose every tool call is intent-verified and policy-checked by ArmorIQ.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "mcp:inbox": "node --env-file-if-exists=.env --import tsx src/mcp/inbox-server.ts",
    "mcp:payments": "node --env-file-if-exists=.env --import tsx src/mcp/payments-server.ts",
    "web": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "agent": "node --env-file-if-exists=.env --import tsx src/cli.ts",
    "reset": "node --import tsx src/mcp/reset.ts",
    "typecheck": "tsc --noEmit",
    "fonts": "node scripts/fetch-fonts.mjs"
  },
  "dependencies": {
    "@armoriq/sdk": "^0.6.10",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "express": "^5.1.0",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "typescript": "^5.9.3"
  }
}
